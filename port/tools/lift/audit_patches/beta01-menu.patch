+def without_detached_brows(tris):
+    """The two black eyebrow islands float above the Smile pose in HOME.
+
+    Keep the connected body surface. Assert the original topology so a future
+    asset cannot silently lose an unrelated part. Eyes/UVs/textures stay intact.
+    """
+    keys = [[tuple(round(float(x), 5) for x in v) for v in t[0]] for t in tris]
+    remaining = set(range(len(tris)))
+    groups = []
+    while remaining:
+        todo = [remaining.pop()]; group = []; vertices = set()
+        while todo:
+            i = todo.pop(); group.append(i); vertices.update(keys[i])
+            adjacent = {j for j in remaining if vertices.intersection(keys[j])}
+            remaining.difference_update(adjacent); todo.extend(adjacent)
+        groups.append(group)
+    assert sorted(map(len, groups)) == [36, 36, 380], 'Unexpected worm body topology'
+    keep = set(max(groups, key=len))
+    return [t for i, t in enumerate(tris) if i in keep]
