+"""Beta 0.1: remove only the two detached brow islands from the approved banner."""
+import json
+from pathlib import Path
+import unittest
+import validate_home_banner as home
+ROOT=Path(__file__).resolve().parents[4]
+OLD=ROOT/'port/build3ds/banner3d-v45'
+NEW=ROOT/'port/build3ds/banner3d-beta01'
+class BetaBanner(unittest.TestCase):
+    def test_only_brows_removed(self):
+        a=json.loads((OLD/'banner.gltf').read_text());b=json.loads((NEW/'banner.gltf').read_text())
+        for key in ('materials','images','textures','samplers'):
+            self.assertEqual(a[key],b[key])
+        for image in a['images']:
+            self.assertEqual((OLD/image['uri']).read_bytes(),(NEW/image['uri']).read_bytes())
+        counts=lambda g: {m['name']:sum(g['accessors'][p['indices']]['count']//3 for p in m['primitives']) for m in g['meshes']}
+        ca,cb=counts(a),counts(b)
+        self.assertEqual(ca.pop('WormBody')-cb.pop('WormBody'),72)
+        self.assertEqual(ca,cb)
+    def test_packaged_home_and_audio(self):
+        model,sound=home.unpack_banner((NEW/'worms3d-animated.bnr').read_bytes())
+        self.assertEqual(model,(NEW/'banner.cgfx').read_bytes())
+        self.assertEqual(sound,home.unpack_banner((OLD/'worms3d-animated.bnr').read_bytes())[1])
+        r=home.inspect(model)
+        self.assertEqual(r['meshes'],28)
+        self.assertEqual(r['skeletal_animations'][0]['rotation_tracks'],0)
+if __name__=='__main__':unittest.main()
