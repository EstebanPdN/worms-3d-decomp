+++ b/port/tools/build3ds/ui/export_weapons.py
@@ -0,0 +1,103 @@
+"""Original weapon meshes for the dual-screen options preview (local disc only).
+
+W3WP v1: magic, u32 version/vertex count/atlas width/height, expanded triangles
+of 8 little-endian floats (position, normal, UV), then an RGBA8 atlas.
+Positions fit a unit sphere so every orientation stays inside the preview.
+"""
+from pathlib import Path
+import hashlib, json, math, struct, sys
+from PIL import Image
+ROOT = Path(__file__).resolve().parents[4]
+sys.path[:0] = [str(ROOT/'tools/macos'), str(ROOT/'mods/ahogo-um/tools')]
+from xom import Xom
+import rig
+
+# Keys identify the two weapons behind each FE.Page-dependent native control.
+# weapon3d.cpp selects them by control AND page, independently of localization.
+MODELS = {
+    'Bazooka':'zook', 'Mortar':'mortar', 'HomingM':'homingmissile', 'Astrike':'bomber',
+    'Grenade':'grenade', 'Cluster':'clustergrenade', 'Gas':'gascanister', 'Banana':'bananabomb',
+    'Shotgun':'shotgun', 'Uzi':'uzi', 'OWoman':'oldwoman', 'MadCow':'cow',
+    'Jetpack':'Jetpack', 'Rope':'Ninjagun', 'Para':'parachute', 'BridgeK':'girder',
+    'Pigeon':'pigeon', 'Axe':'Axe', 'Bat':'bbbat', 'Prod':'Prod', 'HolyHG':'holyhg',
+    'Teleport':'teleport', 'Mine':'landmine', 'SSheep':'supersheep', 'Petrol':'petrolbomb',
+    'Sheep':'sheep', 'TNT':'dynamite', 'Nuke':'suitcase', 'Girder':'girder', 'EQuake':'detonator',
+}
+# Fball is a worm's melee attack; Wselect selects a worm. Both use the existing
+# animated original worm renderer, with its own continuous rotation.
+WORMS = ['Fball', 'Wselect']
+
+def triangles(path):
+    x = Xom(path)
+    out = []
+    identity = rig.aff(rig.euler([0,0,0]), [0,0,0])
+    def walk(i, parent):
+        if x.objects[i]['type'] in ('XSceneCamera','XSceneLight'): return
+        n=x.node(i); m=parent; children=n.get('children', [])
+        if n['type']=='XSkin':
+            sk=rig.load_w3d(str(path))
+            for pp,nn,uu,tex in sk.skin(sk.world()):
+                w,h,pixels=tex
+                rgba=bytes(v for p in pixels for v in (*p[:3],p[3] if len(p)>3 else 255))
+                out.append(([rig.app(m,p) for p in pp], [rig.norm(rig.rot_v(m,v)) for v in nn], uu, (w,h,rgba)))
+            # Rigid accessories of this skeleton are visited with their joints.
+            walk(n['skeleton'], m)
+            return
+        if n['type']=='XSkinShape': return
+        if n['type']=='XGroup' and n['core']:
+            o=x.objects[n['core']]; kind=o['type']
+            if kind in ('XTransform','XJointTransform'):
+                f=struct.unpack('<'+('23f' if kind=='XTransform' else '29f'),o['raw'])
+                local=rig.Joint(i,n['name'],n['name'],'xform' if kind=='XTransform' else 'joint',f,None).local()
+                m=rig.aff_mul(local,parent)
+            elif kind=='XChildSelector':
+                selected=struct.unpack_from('<I',o['raw'])[0]
+                children=children[selected:selected+1]
+        if n['type']=='XShape':
+            mesh=x.mesh(n['geometry']); images=x.shader(n['shader'])['images']
+            tex=x.image(images[0]) if images else (1,1,b'\xff'*4)
+            pp=mesh['vertices']; nn=mesh['normals']; uv=mesh['uv']
+            for k in range(0,len(pp),3):
+                out.append(([rig.app(m,p) for p in pp[k:k+3]],
+                            [rig.norm(rig.rot_v(m,v)) for v in nn[k:k+3]], uv[k:k+3], tex))
+        for child in children: walk(child,m)
+    root=next(g['node'] for _,o in x.of_type('XGraphSet') for g in o['graphs'] if g['name']=='world')
+    walk(root,identity)
+    assert out, path
+    return out
+
+def export():
+    dest=ROOT/'port/platform/3ds/res/ui/weapons';dest.mkdir(exist_ok=True)
+    receipt=[]
+    for key,model in MODELS.items():
+        src=ROOT/'gamedata/GWMP8P/files/Objects'/f'{model}.xom'
+        ts=triangles(src)
+        points=[p for pp,_,_,_ in ts for p in pp]
+        center=[(min(p[k] for p in points)+max(p[k] for p in points))/2 for k in range(3)]
+        radius=max(math.dist(p,center) for p in points)
+        textures=list(dict.fromkeys(tex for _,_,_,tex in ts))
+        # Each original texture gets a 128px tile with duplicated edge texels;
+        # filtering must never bleed into a different material.
+        cols=math.ceil(math.sqrt(len(textures))); rows=math.ceil(len(textures)/cols)
+        w=2**math.ceil(math.log2(cols*130));h=2**math.ceil(math.log2(rows*130))
+        assert w<=1024 and h<=1024
+        atlas=Image.new('RGBA',(w,h)); offsets={}
+        for i,tex in enumerate(textures):
+            iw,ih,px=tex; im=Image.frombytes('RGBA',(iw,ih),px).resize((128,128),Image.Resampling.LANCZOS)
+            ox,oy=(i%cols)*130+1,(i//cols)*130+1;offsets[tex]=(ox,oy)
+            atlas.paste(im,(ox,oy))
+            atlas.paste(im.crop((0,0,1,128)),(ox-1,oy));atlas.paste(im.crop((127,0,128,128)),(ox+128,oy))
+            atlas.paste(im.crop((0,0,128,1)),(ox,oy-1));atlas.paste(im.crop((0,127,128,128)),(ox,oy+128))
+        data=bytearray(b'W3WP'+struct.pack('<4I',1,len(ts)*3,w,h))
+        for pp,nn,uv,tex in ts:
+            ox,oy=offsets[tex]
+            for p,n,u in zip(pp,nn,uv):
+                vals=[(p[k]-center[k])/radius for k in range(3)]+list(n)+[(ox+max(0,min(1,u[0]))*127+.5)/w,(oy+max(0,min(1,u[1]))*127+.5)/h]
+                assert all(math.isfinite(v) for v in vals)
+                data.extend(struct.pack('<8f',*vals))
+        data.extend(atlas.tobytes());out=dest/f'{key}.w3wp';out.write_bytes(data)
+        receipt.append(dict(tip='FE.Tip.'+key,model=str(src.relative_to(ROOT)),source_sha256=hashlib.sha256(src.read_bytes()).hexdigest(),vertices=len(ts)*3,atlas=[w,h],bytes=len(data),sha256=hashlib.sha256(data).hexdigest()))
+        print(key,len(ts),'triangles',w,h,flush=True)
+    (dest/'manifest.json').write_text(json.dumps(dict(models=receipt,worm_previews=WORMS),indent=2)+'\n')
+
+if __name__=='__main__':export()
